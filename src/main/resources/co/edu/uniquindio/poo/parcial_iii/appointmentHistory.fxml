<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial_iii.controllers.AppointmentHistoryController">
    <center>
        <AnchorPane id="mainContent" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="tableAppointments" layoutX="14.0" layoutY="80.0" prefHeight="361.0" prefWidth="576.0" styleClass="custom-table" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="80.0">
                    <columns>
                        <TableColumn fx:id="columnDate" prefWidth="120.0" text="Date and Time" />
                        <TableColumn fx:id="columnDoctor" prefWidth="150.0" text="Doctor" />
                        <TableColumn fx:id="columnStatus" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="columnCost" prefWidth="80.0" text="Cost" />
                        <TableColumn fx:id="columnDescription" prefWidth="200.0" text="Description" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <StackPane prefHeight="61.0" prefWidth="871.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="8.0">
