            </children>
        </AnchorPane>
    </center>
    <bottom>
        <HBox id="rightPane" alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="30.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnBack" alignment="CENTER" mnemonicParsing="false" onAction="#goBack" prefWidth="120.0" styleClass="managerButton" text="Back" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCancelAppointment" mnemonicParsing="false" onAction="#cancelAppointment" prefWidth="150.0" styleClass="managerButton" text="Cancel Appointment" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </bottom>
</BorderPane>